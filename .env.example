# Path to the SQLite database file. The directory must exist and be writable.
DATABASE_URL=data/loreforge.db
# Public origin used by adapter-node for form actions behind a reverse proxy.
ORIGIN=http://localhost:3000
PORT=3000
# Uploaded images. Defaults to <dir of DATABASE_URL>/uploads.
# UPLOADS_DIR=data/uploads
# MAX_UPLOAD_MB=10
# Total image bytes one world may hold, so one account cannot fill the disk. 0 = no limit.
# MAX_WORLD_UPLOAD_MB=2048
# BODY_SIZE_LIMIT=25M
# Behind a reverse proxy, tell adapter-node which header carries the real client address, or
# sign-in rate limits count every visitor as the proxy. XFF_DEPTH is how many proxies you run.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# --- Single sign-on via OpenID Connect (optional; unset = no login required) ---
# OIDC_ISSUER=https://id.example.lan
# OIDC_CLIENT_ID=loreforge
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=Pocket ID
# AUTH_ALLOWED_EMAILS=
# AUTH_ALLOWED_GROUPS=
# SESSION_TTL_DAYS=30
